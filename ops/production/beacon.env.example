# Install as /etc/beacon/beacon.env with owner root:root and mode 0600.
# URL-encode special characters in the generated PostgreSQL password.
POSTGRES_DSN=postgres://beacon:<url-encoded-password>@postgres:5432/beacon?sslmode=disable&pool_max_conns=20
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
POSTGRES_INTERACTIVE_STATEMENT_TIMEOUT=5s
POSTGRES_INTERACTIVE_LOCK_TIMEOUT=500ms
POSTGRES_BACKGROUND_STATEMENT_TIMEOUT=10min
POSTGRES_BACKGROUND_LOCK_TIMEOUT=2s
MQTT_BROKER_1_URL=wss://mqtt1.meshcore.ca:443
MQTT_BROKER_1_USERNAME=<secret>
MQTT_BROKER_1_PASSWORD=<secret>
MQTT_BROKER_2_URL=wss://mqtt2.meshcore.ca:443
MQTT_BROKER_2_USERNAME=<secret>
MQTT_BROKER_2_PASSWORD=<secret>
