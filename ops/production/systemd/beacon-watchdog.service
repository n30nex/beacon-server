[Unit]
Description=Beacon readiness-first watchdog
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/beacon/scripts/watchdog.sh
TimeoutStartSec=8min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beacon /run/lock
