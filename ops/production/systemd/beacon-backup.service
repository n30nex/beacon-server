[Unit]
Description=Beacon verified PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/beacon/scripts/backup.sh
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/beacon /var/lib/beacon /run/lock
